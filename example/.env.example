# Copy to .env and fill in the values. .env is gitignored — never commit real keys.
# This template lists the variable names only; actual values live in .env.

# ── API keys (sensitive) ────────────────────────────────────────────────
API_KEY_STAGING=
API_KEY_SG=
API_KEY_EU=
API_KEY_US=

# ── Region config ───────────────────────────────────────────────────────
# SDK region label shown in the build footer
SDK_REGION_STAGING=
SDK_REGION_SG=
SDK_REGION_EU=
SDK_REGION_US=

# Valid SDK region enum: sg | eu | us
API_REGION_STAGING=
API_REGION_SG=
API_REGION_EU=
API_REGION_US=

# Upload URLs
UPLOAD_URL_STAGING=
UPLOAD_URL_SG=
UPLOAD_URL_EU=
UPLOAD_URL_US=

# Custom HTTP endpoint (Staging only; standard regions derive from API_REGION)
API_ENDPOINT_STAGING=
