# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AmityReactNativeSocialUiKitExample' do
  config = use_native_modules!
  pod 'SPTPersistentCache', :modular_headers => true
  pod 'DVAssetLoaderDelegate', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'livekit-react-native', :path => '../node_modules/@livekit/react-native'
  $RNVideoUseVideoCaching = true
  $RNFirebaseAsStaticFramework = true

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # React Native post-install script
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix fmt consteval error with Xcode 26+ (Apple Clang 21+)
    # The fmt library's consteval usage is broken with newer Apple Clang.
    # Patch base.h to also disable consteval for Apple Clang >= 21.
    fmt_base_path = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_path)
      content = File.read(fmt_base_path)
      unless content.include?('__apple_build_version__ >= 21000000')
        patched = content.gsub(
          '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
          '#elif defined(__apple_build_version__) && (__apple_build_version__ < 14000029L || __apple_build_version__ >= 21000000L)'
        )
        File.chmod(0644, fmt_base_path)
        File.write(fmt_base_path, patched)
        puts "[FMT Patch] Patched fmt/base.h to disable consteval for Xcode 26+ (Apple Clang 21+)"
      end
    end
  end
end
